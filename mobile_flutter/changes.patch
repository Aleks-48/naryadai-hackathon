+      Navigator.of(context).push<void>(MaterialPageRoute(
+        fullscreenDialog: true,
+        builder: (_) => AppSettingsScope(
+          settings: settings,
+          child: _FullScreenPhoto(request: request, name: name),
+        ),
+      )).whenComplete(() {
+        _viewerOpen = false;
+        request.release();
+      });
+    } catch (_) {
+      _viewerOpen = false;
+      request.release();
+      rethrow;
+    }
+  }
+
