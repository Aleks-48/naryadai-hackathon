+                    }).toList(),
+                  ),
+              ],
+            ],
+            if (hasCommand) ...[
+              const SizedBox(height: 16),
+              Text(context.tr('Одноразовая команда'), style: theme.textTheme.titleSmall),
+              const SizedBox(height: 8),
