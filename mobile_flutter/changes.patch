+      if (reset || !ids.contains(id)) {
+        _requests.remove(id)!.retire();
+      }
+    }
+    for (final id in ids) {
+      _requests.putIfAbsent(id, () => _PhotoRequest(widget.api, id));
+    }
+  }
+
+  @override
+  void dispose() {
+    for (final request in _requests.values) {
+      request.retire();
+    }
+    _requests.clear();
+    super.dispose();
+  }
