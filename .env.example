# Optional approved external LLM configuration. Disabled by default. A blank API URL uses the Gemini OpenAI-compatible endpoint.
NARYADAI_LLM_ENABLED=0
NARYADAI_LLM_API_URL=
NARYADAI_LLM_API_KEY=
NARYADAI_LLM_MODEL=
NARYADAI_LLM_REPORT_SUMMARY=0

# Optional Telegram bot adapter. No bot or external messages are created by this project.
NARYADAI_TELEGRAM_ENABLED=0
NARYADAI_TELEGRAM_BOT_TOKEN=
NARYADAI_TELEGRAM_WEBHOOK_SECRET=
