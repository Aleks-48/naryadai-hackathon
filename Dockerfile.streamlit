FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 STREAMLIT_SERVER_ADDRESS=0.0.0.0 STREAMLIT_SERVER_PORT=8501 STREAMLIT_SERVER_HEADLESS=true STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
WORKDIR /app
COPY requirements-streamlit.txt ./requirements-streamlit.txt
RUN pip install --no-cache-dir -r requirements-streamlit.txt && chown -R 10001:10001 /app
COPY --chown=10001:10001 streamlit_app.py ./streamlit_app.py
COPY --chown=10001:10001 server.py ./server.py
COPY --chown=10001:10001 static ./static
COPY --chown=10001:10001 demo_photos ./demo_photos
USER 10001:10001
EXPOSE 8501
CMD ["streamlit", "run", "streamlit_app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
